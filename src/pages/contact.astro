---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact - Shi Han Ng">
  <article class="prose prose-lg max-w-none">
    <h2 class="text-2xl md:text-3xl font-bold mb-6">Get in touch</h2>
    <p class="text-lg md:text-xl leading-relaxed mb-4">
      Feel free to reach out to me through any of these channels:
    </p>
    <ul class="text-lg md:text-xl leading-relaxed list-disc list-inside">
      <li>Email: your.email@example.com</li>
      <li>GitHub: github.com/yourusername</li>
      <li>LinkedIn: linkedin.com/in/yourprofile</li>
    </ul>
  </article>
</BaseLayout>
