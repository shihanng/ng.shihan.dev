---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Shi Han Ng" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white p-4 md:p-8">
    <div class="max-w-4xl mx-auto">
      <header class="mb-8">
        <nav
          class="flex flex-col md:flex-row md:justify-between md:items-start"
        >
          <h1 class="text-2xl md:text-3xl font-bold mb-4 md:mb-0">
            <a href="/">Shi Han Ng</a>
          </h1>
          <div class="flex gap-6 text-xl md:text-2xl">
            <a href="/now" class="hover:underline">Now</a>
            <a href="/contact" class="hover:underline">Contact</a>
          </div>
        </nav>
      </header>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
